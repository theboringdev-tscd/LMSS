---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="Login — LMSS">
  <div class="min-h-screen flex items-center justify-center bg-paper px-4">
    <div class="w-full max-w-sm">
      <div class="text-center mb-8">
        <span class="inline-flex w-12 h-12 rounded bg-gold-leaf items-center justify-center text-binding font-display font-semibold text-xl mb-4">
          LM
        </span>
        <h1 class="font-display text-page-title text-ink">LMSS</h1>
        <p class="text-reading-lamp text-data mt-1">Library Management System</p>
      </div>

      <form class="space-y-4">
        <div>
          <label for="email" class="block text-data text-reading-lamp mb-1">Email</label>
          <input
            type="email"
            id="email"
            class="w-full px-3 py-2 rounded border border-book-cloth bg-paper text-ink text-body focus:outline-none focus:border-leather focus:ring-1 focus:ring-leather"
            placeholder="librarian@library.org"
          />
        </div>
        <div>
          <label for="password" class="block text-data text-reading-lamp mb-1">Password</label>
          <input
            type="password"
            id="password"
            class="w-full px-3 py-2 rounded border border-book-cloth bg-paper text-ink text-body focus:outline-none focus:border-leather focus:ring-1 focus:ring-leather"
          />
        </div>
        <button
          type="submit"
          class="w-full py-2 px-4 rounded bg-leather text-paper font-body font-medium text-body hover:bg-leather/90 transition-colors"
        >
          Sign In
        </button>
      </form>
    </div>
  </div>
</BaseLayout>
