---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="Login — LMSS">
  <div class="min-h-screen flex items-center justify-center bg-paper px-4">
    <div class="w-full max-w-sm">
      <div class="text-center mb-8">
        <span class="inline-flex w-12 h-12 rounded bg-gold-leaf items-center justify-center text-binding font-display font-semibold text-xl mb-4">
          LM
        </span>
        <h1 class="font-display text-page-title text-ink">LMSS</h1>
        <p class="text-reading-lamp text-data mt-1">Library Management System</p>
      </div>

      <form id="login-form" class="space-y-4">
        <div>
          <label for="email" class="block text-data text-reading-lamp mb-1">Email</label>
          <input
            type="email"
            id="email"
            name="email"
            class="w-full px-3 py-2 rounded border border-book-cloth bg-paper text-ink text-body focus:outline-none focus:border-leather focus:ring-1 focus:ring-leather"
            placeholder="admin@library.org"
            required
          />
        </div>
        <div>
          <label for="password" class="block text-data text-reading-lamp mb-1">Password</label>
          <input
            type="password"
            id="password"
            name="password"
            class="w-full px-3 py-2 rounded border border-book-cloth bg-paper text-ink text-body focus:outline-none focus:border-leather focus:ring-1 focus:ring-leather"
            placeholder="Enter your password"
            required
          />
        </div>
        <p id="login-error" class="text-small text-red-600 hidden"></p>
        <button
          type="submit"
          class="w-full py-2 px-4 rounded bg-leather text-paper font-body font-medium text-body hover:bg-leather/90 transition-colors disabled:opacity-50"
        >
          Sign In
        </button>
      </form>
    </div>
  </div>
</BaseLayout>

<script>
import { login, isAuthenticated } from "../lib/api";

if (isAuthenticated()) {
  window.location.href = "/";
}

const form = document.getElementById("login-form") as HTMLFormElement;
const errorEl = document.getElementById("login-error") as HTMLParagraphElement;
const submitBtn = form.querySelector('button[type="submit"]') as HTMLButtonElement;

form.addEventListener("submit", async (e) => {
  e.preventDefault();
  errorEl.classList.add("hidden");
  submitBtn.disabled = true;
  submitBtn.textContent = "Signing in\u2026";

  const email = (document.getElementById("email") as HTMLInputElement).value;
  const password = (document.getElementById("password") as HTMLInputElement).value;

  try {
    await login(email, password);
    window.location.href = "/";
  } catch (err) {
    errorEl.textContent = err instanceof Error ? err.message : "Login failed";
    errorEl.classList.remove("hidden");
    submitBtn.disabled = false;
    submitBtn.textContent = "Sign In";
  }
});
</script>
