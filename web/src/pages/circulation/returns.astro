---
import SidebarLayout from "../../layouts/SidebarLayout.astro";
import ReturnForm from "../../components/circulation/ReturnForm";
---

<SidebarLayout title="Returns — LMSS">
  <section class="space-y-6">
    <header>
      <a href="/circulation" class="text-reading-lamp text-data hover:text-leather transition-colors">&larr; Back to Circulation</a>
      <h1 class="font-display text-page-title text-ink mt-2">Process Returns</h1>
      <p class="text-reading-lamp text-data mt-1">Select an active loan to return</p>
    </header>
    <hr class="gold-rule" aria-hidden="true" />
    <ReturnForm client:load />
  </section>
</SidebarLayout>
