---
import SidebarLayout from "../../layouts/SidebarLayout.astro";
import PatronForm from "../../components/patrons/PatronForm";
---

<SidebarLayout title="Add Patron — LMSS">
  <section class="space-y-6">
    <header>
      <a href="/patrons" class="text-reading-lamp text-data hover:text-leather transition-colors">&larr; Back to Patrons</a>
      <h1 class="font-display text-page-title text-ink mt-2">Add Patron</h1>
    </header>
    <hr class="gold-rule" aria-hidden="true" />
    <PatronForm
      client:load
      onSuccess={() => {
        window.location.href = "/patrons";
      }}
    />
  </section>
</SidebarLayout>
