---
import SidebarLayout from "../../layouts/SidebarLayout.astro";
import PatronDetail from "../../components/patrons/PatronDetail";
export async function getStaticPaths() {
  return [{ params: { id: "placeholder" } }];
}
const { id } = Astro.params;
---

<SidebarLayout title={`Patron ${id} — LMSS`}>
  <section class="space-y-6">
    <header>
      <a href="/patrons" class="text-reading-lamp text-data hover:text-leather transition-colors">&larr; Back to Patrons</a>
      <h1 class="font-display text-page-title text-ink mt-2">Patron Profile</h1>
    </header>
    <hr class="gold-rule" aria-hidden="true" />
    <PatronDetail client:load bookId={id} />
  </section>
</SidebarLayout>
