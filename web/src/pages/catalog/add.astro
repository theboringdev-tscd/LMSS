---
import SidebarLayout from "../../layouts/SidebarLayout.astro";
import AddBookForm from "../../components/catalog/AddBookForm";
---

<SidebarLayout title="Add Book — LMSS">
  <section class="space-y-6">
    <header>
      <a href="/catalog" class="text-reading-lamp text-data hover:text-leather transition-colors">&larr; Back to Catalog</a>
      <h1 class="font-display text-page-title text-ink mt-2">Add Book</h1>
    </header>
    <hr class="gold-rule" aria-hidden="true" />
    <AddBookForm
      client:load
      onSuccess={() => {
        window.location.href = "/catalog";
      }}
    />
  </section>
</SidebarLayout>
